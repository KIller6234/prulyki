# Скопіювати в .env.production на сервері й заповнити реальними значеннями.
# Використовується docker-compose.yml (сервіси db + app).

# --- Postgres (сервіс "db" у docker-compose.yml) ---
POSTGRES_USER=prulyky
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=prulyky

# --- Застосунок (сервіс "app") ---
# Хост "db" — назва сервісу Postgres у тій самій docker-compose мережі,
# не змінювати навіть якщо POSTGRES_USER/PASSWORD/DB вище інші — значення
# мають збігатися з POSTGRES_* вище.
DATABASE_URL="postgresql://prulyky:change-me-to-a-strong-password@db:5432/prulyky?schema=public"

# Новий випадковий рядок ≥32 символів, ВІДМІННИЙ від dev-значення в .env.
SESSION_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Пароль для seed-акаунтів staff. Обов'язково змінити перед показом демки
# стороннім людям і після — див. README, розділ "Staff-кабінет".
STAFF_SEED_PASSWORD="change-me"

# Опційно — без нього ШІ-консультант працює в чесному mock-режимі.
ANTHROPIC_API_KEY=""
