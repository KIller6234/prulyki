# Скопіювати в .env і заповнити реальними значеннями.

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ШІ-консультант. Автовибір провайдера: якщо заданий GEMINI_API_KEY — Gemini;
# інакше ANTHROPIC_API_KEY — Anthropic; інакше mock (чесна відповідь без LLM,
# lib/ai/providers/mock-provider.ts). AI_PROVIDER явно фіксує: gemini|anthropic|mock.
AI_PROVIDER=""
GEMINI_API_KEY=""
GEMINI_MODEL=""              # опційно, дефолт gemini-2.5-flash
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""           # опційно, дефолт claude-haiku-4-5

# Підписання staff-сесій (jose/JWT) — випадковий рядок не менше 32 символів.
SESSION_SECRET=""

# Пароль для seed-акаунтів staff (dev/тест-середовище лише).
STAFF_SEED_PASSWORD=""

# Supabase Storage (фото звернень і майданчиків).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
